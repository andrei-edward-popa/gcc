if { ![istarget stm8-*-*] } {
    return
}

load_lib gcc-dg.exp

if { ![info exists DEFAULT_CFLAGS] } {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.c]] \
    "" $DEFAULT_CFLAGS

dg-finish
