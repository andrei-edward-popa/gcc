config/stm8/stm8-opts.h

mmodel=
Target RejectNegative Joined Var(stm8_memory_model) Enum(stm8_memory_models) Init(STM8_MODEL_MEDIUM)
Select the SDCC-compatible memory model (medium or large).

Enum
Name(stm8_memory_models) Type(enum stm8_model)

EnumValue
